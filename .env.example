# ---------------------------------------------------------------------------
# Desafio Fullstack Keeptor: variáveis do ambiente local
#
#   npm run setup            (cria este arquivo e o do frontend)
#
# Tudo aqui é credencial de DESENVOLVIMENTO LOCAL e está versionado de
# propósito, para que o ambiente suba sem nenhuma configuração manual.
# Nunca reutilize estes valores fora da sua máquina.
# ---------------------------------------------------------------------------

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
# Porta do Postgres NO HOST (psql / DBeaver / TablePlus). Dentro da rede
# docker o Postgres é sempre db:5432.
POSTGRES_PORT=5432

# --- JWT -------------------------------------------------------------------
# Secret oficial de demonstração do repositório supabase/docker.
# As chaves abaixo são JWTs HS256 assinados com ELE. Trocar o secret sem
# regerar as chaves quebra o login com 401.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Chave pública (role=anon). É a FONTE DA VERDADE do ambiente: é ela que o
# GoTrue e o PostgREST validam. O frontend recebe uma cópia dela via
# `npm run setup`, que preenche o frontend/.env a partir daqui. Não edite o
# frontend/.env na mão: se as duas divergirem, o login devolve 401 sem
# explicação (o passo 10 do `npm run smoke` avisa quando isso acontece).
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE3NjcyMjU2MDAsImV4cCI6MjA1MTIyMjQwMH0.oqNjg-oy3SwR96LB2_v6nh4Zlv19ak4JP8fTmyYRaes

# Chave de serviço (role=service_role). IGNORA RLS. Só para scripts/admin,
# NUNCA no frontend.
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTc2NzIyNTYwMCwiZXhwIjoyMDUxMjIyNDAwfQ.t9-BExJIPiljoy9ufGv_byaZcGB1wyzaj61-D0Hzils

# --- API (Kong) ------------------------------------------------------------
KONG_HTTP_PORT=8000
API_EXTERNAL_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- Auth (GoTrue) ---------------------------------------------------------
# Origem do seu frontend (Vite roda em 5173 por padrão).
SITE_URL=http://localhost:5173
ADDITIONAL_REDIRECT_URLS=http://localhost:5173,http://localhost:5173/*
DISABLE_SIGNUP=false
GOTRUE_LOG_LEVEL=info

# --- Usuário demo ----------------------------------------------------------
# Criado no primeiro boot pelo serviço one-shot `auth-seed`, via Admin API do
# GoTrue, não por migration. O porquê está no backend/README.md.
SEED_EMAIL=desafio@keeptor.com
SEED_PASSWORD=desafio123

# --- PostgREST -------------------------------------------------------------
PGRST_DB_SCHEMAS=public

# --- Studio ----------------------------------------------------------------
# Supabase Studio (Table Editor / SQL Editor) em http://localhost:3000
STUDIO_PORT=3000
STUDIO_DEFAULT_ORGANIZATION=Keeptor
# Aspas porque o valor tem espaço: assim o arquivo continua seguro de ser lido
# com `source .env` num shell (o Compose remove as aspas sozinho).
STUDIO_DEFAULT_PROJECT="Desafio Fullstack"

# ---------------------------------------------------------------------------
# Como estas chaves foram geradas (caso você queira trocar o JWT_SECRET):
#
#   node -e '
#     const c=require("crypto"), s="SEU_SECRET";
#     const b=o=>Buffer.from(JSON.stringify(o)).toString("base64url");
#     const sign=r=>{const h=b({alg:"HS256",typ:"JWT"});
#       const p=b({role:r,iss:"supabase-demo",iat:1767225600,exp:2051222400});
#       return `${h}.${p}.${c.createHmac("sha256",s).update(h+"."+p).digest("base64url")}`};
#     console.log("ANON_KEY="+sign("anon"));
#     console.log("SERVICE_ROLE_KEY="+sign("service_role"));'
#
# Payload das chaves acima: iss=supabase-demo, iat=2026-01-01, exp=2035-01-01.
#
# Ao regerar as chaves, apague o frontend/.env e rode `npm run setup` de novo:
# é ele quem leva a ANON_KEY nova para o frontend.
# ---------------------------------------------------------------------------
